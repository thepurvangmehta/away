{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "[ -f \"$HOME/.claude/away.on\" ] || exit 0; P=python3; $P -c '' 2>/dev/null || P=python; $P \"${CLAUDE_PLUGIN_ROOT}/scripts/away.py\"", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "[ -f \"$HOME/.claude/away.on\" ] || exit 0; P=python3; $P -c '' 2>/dev/null || P=python; $P \"${CLAUDE_PLUGIN_ROOT}/scripts/away.py\"", "timeout": 10 }] }
    ],
    "PermissionRequest": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "[ -f \"$HOME/.claude/away.on\" ] || exit 0; P=python3; $P -c '' 2>/dev/null || P=python; $P \"${CLAUDE_PLUGIN_ROOT}/scripts/away.py\"", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "[ -f \"$HOME/.claude/away.on\" ] || exit 0; P=python3; $P -c '' 2>/dev/null || P=python; $P \"${CLAUDE_PLUGIN_ROOT}/scripts/away.py\"", "timeout": 10 }] }
    ]
  }
}
