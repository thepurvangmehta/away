{
  "hooks": {
    "PermissionRequest": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/away.py\"", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion|ExitPlanMode|.*Claude_Browser__(navigate|preview_start|tabs_create)|.*claude-in-chrome__(navigate|tabs_create)", "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/away.py\"", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/away.py\"", "timeout": 10 }] }
    ]
  }
}
